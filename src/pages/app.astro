---
import App from '@/App'
import '@/index.css'
import { withBase } from '@/i18n/copy'

const title = 'Tintfield · App'
const canonical = new URL(withBase('/app'), Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Tintfield color scale generator" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link
      rel="alternate"
      hreflang="de"
      href={new URL(withBase('/de/app'), Astro.site).href}
    />
  </head>
  <body class="min-h-svh bg-[var(--bg)] text-[var(--text)]">
    <App client:only="react" />
  </body>
</html>
